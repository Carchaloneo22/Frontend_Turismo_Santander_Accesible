# ── Backend (API) ──
# Sin definir → '/php', que el proxy del dev server de Vite reenvía al backend local.
# Dejarlo VACÍO en desarrollo: así el navegador lo ve same-origin y no hay CORS.
# En producción, la URL real del backend:
#   VITE_API_BASE_URL=https://api.pablocarvajal.dev
VITE_API_BASE_URL=

# Entorno
VITE_APP_ENV=development

# Dominio oficial del sitio (SEO/OpenGraph). Sin él se usa un placeholder.
VITE_SITE_URL=https://santander-accesible.co
