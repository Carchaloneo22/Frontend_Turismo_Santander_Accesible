{
  "name": "santander-accesible",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ayuda": "node scripts/ayuda.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/spa-fallback.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "scripts-info": {
    "ayuda": "Muestra esta lista: todos los scripts con su descripción.",
    "dev": "Levanta el servidor de desarrollo de Vite (puerto 5174, HTTPS, con proxy /api al backend).",
    "build": "Verifica tipos (tsc -b), genera el build de producción en dist/ y crea el fallback SPA (404.html).",
    "lint": "ESLint sobre todo el proyecto (mismo chequeo que el CI).",
    "preview": "Sirve el build de dist/ en local para probarlo como en producción.",
    "test": "Corre Vitest en modo watch (desarrollo).",
    "test:run": "Corre Vitest una sola vez y termina (lo que usa el CI).",
    "prepare": "Instala los hooks de git (Husky). Lo ejecuta npm automáticamente.",
    "format": "Formatea todo el proyecto con Prettier (escribe los cambios).",
    "format:check": "Solo verifica el formato, sin escribir."
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/xr": "^6.6.30",
    "axios": "^1.18.1",
    "gsap": "^3.15.0",
    "maplibre-gl": "^4.7.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
